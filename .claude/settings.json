{
  "permissions": {
    "deny": [
      "Read(~/data/agentops/holdout/**)",
      "Edit(~/.agentops/approvals/**)",
      "Write(~/.agentops/approvals/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "denyRead": ["~/data/agentops/holdout"],
      "allowWrite": ["~/.agentops/inbox", "~/.cache/uv"]
    },
    "network": {
      "allowedDomains": []
    }
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "PYTHONHASHSEED": "0"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/python3.12\" \"$HOME/agentops/hooks/protect_tests.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/python3.12\" \"$HOME/agentops/hooks/register_session.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/python3.12\" \"$HOME/agentops/hooks/stop_report.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/python3.12\" \"$HOME/agentops/hooks/session_end.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
